{
  "name": "melt",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx apps/api/src/index.ts",
    "test": "npm run test:contracts && tsx --test apps/api/src/*.test.ts && npm run test:sdk",
    "test:contracts": "forge test --root contracts -vv",
    "test:e2e": "playwright test tests/platform.spec.ts",
    "chain:deploy": "node --env-file-if-exists=.env --import tsx scripts/deploy-session.ts",
    "agent:demo": "node --env-file-if-exists=.env --import tsx scripts/agent-demo.ts",
    "format": "prettier --write apps packages scripts/dev.mjs scripts/deploy-session.ts scripts/agent-demo.ts scripts/openapi.ts tests/platform.spec.ts tests/restart.test.ts docs/*.md docs/research/*.md docs/openapi.json *.json vite.config.ts playwright.config.ts README.md FEEDBACK.md",
    "agent:mcp": "node --env-file-if-exists=.env --import tsx packages/sdk/src/mcp.ts",
    "check": "npm run build && npm test && npm run test:e2e && npm run test:restart",
    "test:restart": "node --import tsx --test tests/restart.test.ts",
    "docs:api": "tsx scripts/openapi.ts",
    "test:sdk": "node --test packages/sdk/client.test.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@privy-io/node": "^0.34.0",
    "@privy-io/react-auth": "^3.40.0",
    "@stripe/stripe-js": "^9.15.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "motion": "^13.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "viem": "^2.37.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "solc": "0.8.30",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "axios": "^1.18.0",
    "ws@>=8 <9": "^8.21.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.13.0"
  }
}
