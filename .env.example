# Local playground: leave everything below commented. No accounts or keys needed.
# npm ci && npx playwright install chromium && npm run dev
# ANVIL_BIN=/absolute/path/to/anvil

# Agent-driven Uniswap swaps against real Uniswap V3 contracts: fork mainnet
# locally (chain id stays 31337). MELT_FORK=1 uses a public RPC; or set your own.
# MELT_FORK=1
# FORK_RPC_URL=https://ethereum-rpc.publicnode.com
# FORK_BLOCK=

# Configured wallet mode (server secrets stay on the server):
# RPC_URL=https://your-ethereum-testnet-rpc
# CHAIN_ID=11155111
# CHAIN_NAME=Sepolia
# NATIVE_SYMBOL=ETH
# EXPLORER_URL=https://sepolia.etherscan.io
# APP_ORIGIN=http://127.0.0.1:5173
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_RELAYER_WALLET_ID=      # optional: created and persisted if absent
# PRIVY_POLICY_ID=              # optional policy attached when a relayer is created

# Public browser RPC; bundled in the website. Use a public/restricted endpoint.
# Never put server secrets into a VITE_ variable.
# VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# VITE_PRIVY_APP_ID=             # public app ID for independent recovery sign-in
# VITE_CHAIN_ID=11155111
# VITE_CHAIN_NAME=Sepolia
# VITE_EXPLORER_URL=https://sepolia.etherscan.io

# Autonomous browser driver. Any OpenAI-compatible Chat Completions endpoint.
# An OpenAI key works with just AI_API_KEY (base URL + gpt-4o-mini are inferred);
# set AI_MODEL to override the model, or AI_BASE_URL for another provider.
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://openrouter.ai/api/v1
# Local OpenAI-compatible server is also supported; use a non-secret placeholder
# API key if your local server ignores authentication.

# Optional owner-controlled conversion before funding:
# UNISWAP_API_KEY=

# Optional gift-card issuance. Public brand list works with MELT_REMOTE_CATALOG=1.
# Creating a live Cryptorefills order (mainnet only) needs an application key.
# CRYPTOREFILLS_API_KEY=

# Real gift-card catalog from Cryptorefills (public API, no account needed).
# Adds food, game, and eSIM brands (Uber Eats, DoorDash, Steam, ...) to discovery.
# MELT_REMOTE_CATALOG=1

# Public testnet demo: deploy fixture explicitly using npm run chain:deploy.
# FIXTURE_CONTRACT=0x...
# ENABLE_TEST_FIXTURES=true
# FIXTURE_ORIGIN=https://your-domain/demo

# Hosting:
# HOST=0.0.0.0
# PORT=8787
# DATA_DIR=data/task-wallet
# NODE_ENV=production

# Agent client/MCP (create a revocable key at /developers):
# MELT_API_URL=http://127.0.0.1:8787
# MELT_API_KEY=melt_...
# MELT_SESSION_ID=

# Optional isolated remote Chromium for hosts that cannot run the local sandbox.
# Browserless free plan: two-minute browser connections, no recording or replay.
BROWSERLESS_TOKEN=
# Exact trusted hostnames for remote page navigation. Leave empty to allow any
# public HTTPS site. Resource hosts are not listed here.
# Remote providers do not guarantee local Chromium DNS pinning.
BROWSER_ALLOWED_HOSTS=

# Gift emails. Apps Script web app owned by boltdoesthis@gmail.com.
# MAIL_WEBHOOK=
# MAIL_SECRET=
# MAIL_FROM=boltdoesthis@gmail.com
# MAIL_FROM_NAME=Melt
